---
import '../styles/services.css';
// EDITABLE: 8 service cards, titles, descriptions, icons and URLs.
const services = [
  { title: 'Mantenimiento Industrial Integral', description: 'Soluciones correctivas y preventivas para maximizar la continuidad operativa en plantas e instalaciones energéticas.', icon: '⚙', url: '/servicios/mantenimiento-industrial' },
  { title: 'Instalación y Mantenimiento de Tuberías', description: 'Montaje, inspección y rehabilitación de ductos para la industria petrolera y de gas con estándares internacionales.', icon: '⌁', url: '/servicios/tuberias' },
  { title: 'Soldadura Especializada y Alta Presión', description: 'Servicios de soldadura certificada para estructuras críticas, recipientes a presión y líneas de conducción.', icon: '✦', url: '/servicios/soldadura-especializada' },
  { title: 'Construcción Civil y Estructural', description: 'Desarrollo de infraestructura industrial, cimentaciones profundas y montaje de estructuras de acero de gran escala.', icon: '▦', url: '/servicios/construccion-civil' },
  { title: 'Ingeniería de Proyectos EPC', description: 'Diseño conceptual, básico y de detalle, procura y construcción llave en mano para el sector energético.', icon: '⌑', url: '/servicios/ingenieria-epc' },
  { title: 'Servicios Anticorrosivos y Recubrimientos', description: 'Aplicación de sistemas de protección catódica y recubrimientos industriales para atmósferas agresivas.', icon: '◇', url: '/servicios/recubrimientos' },
  { title: 'Instrumentación y Control de Procesos', description: 'Automatización, calibración y mantenimiento de sistemas de control para optimizar refinerías y plantas industriales.', icon: '⎋', url: '/servicios/instrumentacion-control' },
  { title: 'Paradas de Planta y Mantenimiento Mayor', description: 'Planificación y ejecución ágil de trabajos críticos durante paros programados de operación industrial.', icon: '◷', url: '/servicios/mantenimiento-mayor' },
];
---

<section id="servicios" class="services-radial" data-services-radial aria-labelledby="services-radial-title">
  <!-- Puente técnico SHRIMP — dividido en 2 mitades con textos laterales incorporados -->
  <div class="services-bridge" data-services-bridge aria-hidden="true">
    <div class="services-bridge__inner">
      <div class="services-bridge__side services-bridge__side--left" data-bridge-left>Donde <strong>comienzan</strong></div>
      <div class="services-bridge__side services-bridge__side--right" data-bridge-right>Los mejores <strong>proyectos</strong></div>
      <!-- SVG SUB (trazo secundario tenue) -->
      <svg class="services-bridge-svg services-bridge-svg--sub" viewBox="0 0 1920 914" fill="none" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" role="presentation">
        <defs>
          <linearGradient id="simicoGradSub" x1="1926" y1="-47.4999" x2="43.5" y2="937" gradientUnits="userSpaceOnUse">
            <stop stop-color="#ffffff" stop-opacity="0"/>
            <stop offset="0.5" stop-color="#f0f2f4" stop-opacity="1"/>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
          </linearGradient>
          <filter id="simicoGlow" x="-20%" y="-20%" width="140%" height="140%">
            <feGaussianBlur in="SourceGraphic" stdDeviation="3.2" result="blur"/>
            <feOffset dx="0" dy="0" result="off"/>
            <feFlood flood-color="#EA3221" flood-opacity="0.32" result="col"/>
            <feComposite in="col" in2="blur" operator="in" result="glow"/>
            <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
          </filter>
        </defs>
        <path id="simicoPathSub" class="services-bridge-track services-bridge-track--sub" d="M-10 913H634C645.046 913 654 904.046 654 893V482.5C654 471.454 662.954 462.5 674 462.5H935C946.046 462.5 955 453.546 955 442.5V227.5C955 216.454 963.954 207.5 975 207.5H1573.5C1584.55 207.5 1593.5 216.454 1593.5 227.5V325.5C1593.5 336.546 1602.45 345.5 1613.5 345.5H1734.5C1745.5 345.5 1754.5 336.546 1754.5 325.5V20.5C1754.5 9.4543 1763.45 0.5 1774.5 0.5H2092.5" stroke="url(#simicoGradSub)" stroke-opacity="0.55" vector-effect="non-scaling-stroke"/>
        <path data-bridge-pulse-sub class="services-bridge-pulse services-bridge-pulse--sub" d="M-10 913H634C645.046 913 654 904.046 654 893V482.5C654 471.454 662.954 462.5 674 462.5H935C946.046 462.5 955 453.546 955 442.5V227.5C955 216.454 963.954 207.5 975 207.5H1573.5C1584.55 207.5 1593.5 216.454 1593.5 227.5V325.5C1593.5 336.546 1602.45 345.5 1613.5 345.5H1734.5C1745.5 345.5 1754.5 336.546 1754.5 325.5V20.5C1754.5 9.4543 1763.45 0.5 1774.5 0.5H2092.5" pathLength="1000" stroke-dasharray="90 910" vector-effect="non-scaling-stroke"/>
        <path data-bridge-pulse-sub-ghost class="services-bridge-pulse services-bridge-pulse--sub-ghost" d="M-10 913H634C645.046 913 654 904.046 654 893V482.5C654 471.454 662.954 462.5 674 462.5H935C946.046 462.5 955 453.546 955 442.5V227.5C955 216.454 963.954 207.5 975 207.5H1573.5C1584.55 207.5 1593.5 216.454 1593.5 227.5V325.5C1593.5 336.546 1602.45 345.5 1613.5 345.5H1734.5C1745.5 345.5 1754.5 336.546 1754.5 325.5V20.5C1754.5 9.4543 1763.45 0.5 1774.5 0.5H2092.5" pathLength="1000" stroke-dasharray="48 952" vector-effect="non-scaling-stroke"/>
      </svg>
      <!-- SVG MAIN (trazo principal industrial) -->
      <svg class="services-bridge-svg services-bridge-svg--main" viewBox="0 0 1920 915" fill="none" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" role="presentation">
        <defs>
          <linearGradient id="simicoGradMain" x1="1896" y1="-46.9999" x2="13.5" y2="937.5" gradientUnits="userSpaceOnUse">
            <stop stop-color="#ffffff" stop-opacity="0"/>
            <stop offset="0.5" stop-color="#ffffff" stop-opacity="1"/>
            <stop offset="1" stop-color="#ffffff" stop-opacity="0"/>
          </linearGradient>
        </defs>
        <path id="simicoPathMain" class="services-bridge-track services-bridge-track--main" d="M-40 913.5H604C615.046 913.5 624 904.546 624 893.5V483C624 471.954 632.954 463 644 463H905C916.046 463 925 454.046 925 443V228C925 216.954 933.954 208 945 208H1543.5C1554.55 208 1563.5 216.954 1563.5 228V326C1563.5 337.046 1572.45 346 1583.5 346H1704.5C1715.55 346 1724.5 337.046 1724.5 326V212C1724.5 9.9543 1733.45 1 1744.5 1H2062.5" stroke="url(#simicoGradMain)" stroke-opacity="0.48" vector-effect="non-scaling-stroke"/>
        <path data-bridge-pulse-main class="services-bridge-pulse services-bridge-pulse--main" d="M-40 913.5H604C615.046 913.5 624 904.546 624 893.5V483C624 471.954 632.954 463 644 463H905C916.046 463 925 454.046 925 443V228C925 216.954 933.954 208 945 208H1543.5C1554.55 208 1563.5 216.954 1563.5 228V326C1563.5 337.046 1572.45 346 1583.5 346H1704.5C1715.55 346 1724.5 337.046 1724.5 326V212C1724.5 9.9543 1733.45 1 1744.5 1H2062.5" pathLength="1000" stroke-dasharray="120 880" vector-effect="non-scaling-stroke"/>
        <path data-bridge-pulse-main-ghost class="services-bridge-pulse services-bridge-pulse--main-ghost" d="M-40 913.5H604C615.046 913.5 624 904.546 624 893.5V483C624 471.954 632.954 463 644 463H905C916.046 463 925 454.046 925 443V228C925 216.954 933.954 208 945 208H1543.5C1554.55 208 1563.5 216.954 1563.5 228V326C1563.5 337.046 1572.45 346 1583.5 346H1704.5C1715.55 346 1724.5 337.046 1724.5 326V212C1724.5 9.9543 1733.45 1 1744.5 1H2062.5" pathLength="1000" stroke-dasharray="62 938" vector-effect="non-scaling-stroke"/>
      </svg>
    </div>
  </div>
  <div class="services-radial-pin" data-services-radial-pin>
    <div class="services-radial-wipe" aria-hidden="true"></div>
    <div class="services-stage" data-services-stage>
      <div class="services-wheel-disc" data-services-wheel aria-hidden="true"></div>
      <div class="services-radial-heading">
        <!-- EDITABLE: Section Heading — kicker eliminado por brief, h3 en puente -->
        <h2 id="services-radial-title">Servicios</h2>
      </div>
      <div class="services-cards-orbit" data-services-cards>
      {services.map((service) => (
        <article class="service-radial-card" data-service-card>
          <div class="service-radial-card-head">
            <div class="service-radial-icon" aria-hidden="true"><span>{service.icon}</span></div>
          </div>
          <h3>{service.title}</h3>
          <p class="service-radial-description">{service.description}</p>
          <a class="sr-only-link" href={service.url}>Ver servicio: {service.title}</a>
        </article>
      ))}
      </div>
      <nav class="services-radial-navigation" aria-label="Navegación del carrusel de servicios">
        <button type="button" data-services-previous aria-label="Mostrar servicio anterior"><span aria-hidden="true">←</span> Anterior</button>
        <button type="button" data-services-next aria-label="Mostrar servicio siguiente">Siguiente <span aria-hidden="true">→</span></button>
      </nav>
    </div>
  </div>
</section>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const section = document.querySelector('[data-services-radial]');
  const pin = document.querySelector('[data-services-radial-pin]');
  const stage = document.querySelector('[data-services-stage]');
  const wipe = document.querySelector('.services-radial-wipe');
  const wheel = document.querySelector('[data-services-wheel]');
  const cards = gsap.utils.toArray('[data-service-card]');
  const previous = document.querySelector('[data-services-previous]');
  const next = document.querySelector('[data-services-next]');
  const bridge = document.querySelector('[data-services-bridge]');
  const pulseSub = document.querySelector('[data-bridge-pulse-sub]');
  const pulseSubGhost = document.querySelector('[data-bridge-pulse-sub-ghost]');
  const pulseMain = document.querySelector('[data-bridge-pulse-main]');
  const pulseMainGhost = document.querySelector('[data-bridge-pulse-main-ghost]');
  const trackSub = document.getElementById('simicoPathSub');
  const trackMain = document.getElementById('simicoPathMain');
  const sideLeft = document.querySelector('[data-bridge-left]');
  const sideRight = document.querySelector('[data-bridge-right]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 768px)').matches;

  // Reduced: puente oculto
  if (bridge && reduced) {
    gsap.set(bridge, { autoAlpha: 0 });
  }

  if (section && pin && stage && wheel && cards.length && !reduced && desktop) {
    const step = 360 / cards.length;
    const state = { rotation: 0 };
    let activeIndex = 0;
    let scrollTrigger;
    const heading = stage.querySelector('.services-radial-heading');
    const kicker = heading?.querySelector('.services-page-kicker');
    const headingTitle = heading?.querySelector('h2');
    const headingDesc = heading?.querySelector('h3');
    const cardsOrbit = document.querySelector('[data-services-cards]');

    let navIndex = 0;
    const updateWheel = () => {
      const radius = Math.min(window.innerWidth * 0.58, window.innerHeight * 0.9);
      wheel.style.transform = `translate(-50%, -50%) rotate(${state.rotation}deg)`;
      cards.forEach((card, index) => {
        const angle = 90 + index * step + state.rotation;
        const radians = angle * Math.PI / 180;
        const x = Math.cos(radians) * radius;
        const y = Math.sin(radians) * radius;
        const distance = Math.abs((((angle - 90) % 360) + 540) % 360 - 180);
        const focus = gsap.utils.clamp(0, 1, 1 - distance / 72);
        gsap.set(card, {
          x,
          y,
          xPercent: -50,
          yPercent: -50,
          opacity: 0.22 + focus * 0.78,
          scale: 0.86 + focus * 0.16,
          zIndex: Math.round(focus * 20),
        });
        card.classList.toggle('is-active', focus > 0.78);
        if (focus > 0.78) activeIndex = index;
      });
      navIndex = activeIndex;
      previous?.toggleAttribute('disabled', activeIndex === 0);
      next?.toggleAttribute('disabled', activeIndex === cards.length - 1);
    };

    // Estado inicial: puente oculto (evita flash), sides en laterales 6% y stage+heading desplazados
    gsap.set(bridge, { autoAlpha: 0 });
    if (trackSub) gsap.set(trackSub, { autoAlpha: 0 });
    if (trackMain) gsap.set(trackMain, { autoAlpha: 0 });
    if (pulseSub) gsap.set(pulseSub, { strokeDashoffset: 1040, autoAlpha: 1 });
    if (pulseSubGhost) gsap.set(pulseSubGhost, { strokeDashoffset: 1040, autoAlpha: 1 });
    if (pulseMain) gsap.set(pulseMain, { strokeDashoffset: 1000, autoAlpha: 1 });
    if (pulseMainGhost) gsap.set(pulseMainGhost, { strokeDashoffset: 1000, autoAlpha: 1 });
    if (sideLeft) gsap.set(sideLeft, { autoAlpha: 0, x: -18, yPercent: -50 });
    if (sideRight) gsap.set(sideRight, { autoAlpha: 0, x: 18, yPercent: -50 });
    gsap.set(stage, { autoAlpha: 0, filter: 'blur(10px)' });
    if (wipe) gsap.set(wipe, { autoAlpha: 1 });
    if (headingTitle) gsap.set(headingTitle, { autoAlpha: 0, y: 24 });
    if (wheel) gsap.set(wheel, { autoAlpha: 0 });
    if (cardsOrbit) gsap.set(cardsOrbit, { autoAlpha: 0 });

    // ── FASE 1: PUENTE SHRIMP (scroll natural, sin pin) — 90% fiel + 150% SIMICO ──
    // Fidedigno al ref: 2 SVGs (sub/main) con gradient + dash 90/910 y 120/880.
    // Potenciado: doble pulso ghost, glow #EA3221, grosor mayor, tracks Industrial Gray.
    // Límite estricto ANTES de "Servicios": puente hace scrub mientras entra la sección,
    // se desvanece justo antes de que el heading tome protagonismo.
    const bridgeEnter = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top 88%',
        end: 'top top',
        scrub: 5.8,
        invalidateOnRefresh: true,
      },
    });
    bridgeEnter
      .to(bridge, { autoAlpha: 1, duration: 0.14, ease: 'power1.out' }, 0)
      .to(trackSub, { autoAlpha: 1, duration: 0.22, ease: 'power1.out' }, 0.04)
      .to(trackMain, { autoAlpha: 1, duration: 0.22, ease: 'power1.out' }, 0.06)
      .fromTo(pulseSub, { strokeDashoffset: 1040 }, { strokeDashoffset: -280, duration: 0.92, ease: 'none' }, 0)
      .fromTo(pulseSubGhost, { strokeDashoffset: 1040 }, { strokeDashoffset: -360, duration: 0.92, ease: 'none' }, 0.07)
      .fromTo(pulseMain, { strokeDashoffset: 1000 }, { strokeDashoffset: -320, duration: 0.92, ease: 'none' }, 0.03)
      .fromTo(pulseMainGhost, { strokeDashoffset: 1000 }, { strokeDashoffset: -400, duration: 0.92, ease: 'none' }, 0.10)
      .to(sideLeft, { autoAlpha: 1, x: -18, yPercent: -50, duration: 0.30, ease: 'power2.out' }, 0.10)
      .to(sideRight, { autoAlpha: 1, x: 18, yPercent: -50, duration: 0.30, ease: 'power2.out' }, 0.10)
      // Espera prolongada en laterales 6% antes de juntarse — unión muy lenta y desvanecido progresivo
      .to(sideLeft, { x: '33vw', yPercent: -50, duration: 0.48, ease: 'power1.inOut' }, 0.72)
      .to(sideRight, { x: '-33vw', yPercent: -50, duration: 0.48, ease: 'power1.inOut' }, 0.72)
      .to(wipe, { autoAlpha: 0, duration: 0.18, ease: 'power1.out' }, 0.02)
      .to([sideLeft, sideRight], { autoAlpha: 0, duration: 0.36, ease: 'power1.out' }, 0.84)
      .to(bridge, { autoAlpha: 0, duration: 0.22, ease: 'power1.inOut' }, 0.90)
      .to([trackSub, trackMain], { autoAlpha: 0, duration: 0.16, ease: 'power1.inOut' }, '<');

    // ── FASE 2: CARRUSEL ANCLADO (pin) — título primero, luego plato claro desde el fondo ──
    // El bloqueo de scroll empieza AQUÍ. "Servicios" aparece nítido, luego el plato se aclara.
    const pinned = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: 'bottom bottom',
        pin,
        pinSpacing: false,
        scrub: 1,
        invalidateOnRefresh: true,
        onRefresh: updateWheel,
      },
    });
    pinned
      .fromTo(stage, { autoAlpha: 0, filter: 'blur(12px)' }, { autoAlpha: 1, filter: 'blur(0px)', duration: 0.10, ease: 'power2.out' }, 0)
      .fromTo(headingTitle, { autoAlpha: 0, y: 28 }, { autoAlpha: 1, y: 0, duration: 0.12, ease: 'power2.out' }, 0.02)
      .to(wheel, { autoAlpha: 1, duration: 0.18, ease: 'power1.out' }, 0.14)
      .to(cardsOrbit, { autoAlpha: 1, duration: 0.18, ease: 'power1.out' }, 0.16)
      .to(state, { rotation: -step * (cards.length - 1), duration: 0.82, ease: 'none', onUpdate: updateWheel }, 0.20);

    scrollTrigger = pinned.scrollTrigger;
    const goToCard = (index) => {
      const target = gsap.utils.clamp(0, cards.length - 1, index);
      const targetRotation = -step * target;
      gsap.to(state, {
        rotation: targetRotation,
        duration: 0.65,
        ease: 'power2.inOut',
        overwrite: 'auto',
        onUpdate: updateWheel,
      });
    };

    if (previous) {
      previous.style.pointerEvents = 'auto';
      previous.addEventListener('click', (e) => { e.preventDefault(); goToCard(navIndex - 1); });
    }
    if (next) {
      next.style.pointerEvents = 'auto';
      next.addEventListener('click', (e) => { e.preventDefault(); goToCard(navIndex + 1); });
    }

    window.addEventListener('resize', updateWheel);
    updateWheel();
  }

  // ── MÓVIL: kickers arriba/abajo → centro fade, título centro→arriba, plato invertido 1 tarjeta ──
  if (section && pin && stage && wheel && cards.length && !reduced && !desktop) {
    const step = 360 / cards.length;
    const state = { rotation: 0 };
    let activeIndex = 0;
    const headingTitle = stage.querySelector('h2');
    const cardsOrbit = document.querySelector('[data-services-cards]');
    const sideLeftM = sideLeft;
    const sideRightM = sideRight;

    const updateWheelMobile = () => {
      // Mini plato simétrico centrado — vecinos pre-renderizados para fluidez
      const wheelW = Math.min(window.innerWidth * 3.33, 1439);
      const radius = wheelW * 0.34;
      wheel.style.transform = `translate(-50%, -50%) rotate(${state.rotation}deg)`;
      cards.forEach((card, index) => {
        const angle = 90 + index * step + state.rotation; // 90 = 6:00 abajo
        const rad = angle * Math.PI / 180;
        const x = Math.cos(rad) * radius;
        const y = Math.sin(rad) * radius;
        const dist = Math.abs((((angle - 90) % 360) + 540) % 360 - 180);
        const focus = gsap.utils.clamp(0, 1, 1 - dist / 55);
        const isActive = focus > 0.62;
        gsap.set(card, {
          x, y, xPercent: -50, yPercent: -50,
          // vecinos ya disponibles con opacidad baja para fluidez (no 0)
          opacity: isActive ? 0.98 : 0.22 + focus * 0.35,
          scale: isActive ? 1 : 0.88 + focus * 0.10,
          zIndex: Math.round(focus * 10),
          pointerEvents: isActive ? 'auto' : 'none',
        });
        card.classList.toggle('is-active', isActive);
        if (isActive) activeIndex = index;
      });
    };

    // Estado inicial móvil: puente oculto, heading en centro
    gsap.set(bridge, { autoAlpha: 0 });
    if (trackSub) gsap.set(trackSub, { autoAlpha: 0 });
    if (trackMain) gsap.set(trackMain, { autoAlpha: 0 });
    if (pulseSub) gsap.set(pulseSub, { strokeDashoffset: 1040, autoAlpha: 1 });
    if (pulseSubGhost) gsap.set(pulseSubGhost, { strokeDashoffset: 1040, autoAlpha: 1 });
    if (pulseMain) gsap.set(pulseMain, { strokeDashoffset: 1000, autoAlpha: 1 });
    if (pulseMainGhost) gsap.set(pulseMainGhost, { strokeDashoffset: 1000, autoAlpha: 1 });
    if (sideLeftM) gsap.set(sideLeftM, { autoAlpha: 0, y: -12 });
    if (sideRightM) gsap.set(sideRightM, { autoAlpha: 0, y: 12 });
    gsap.set(stage, { autoAlpha: 0, filter: 'blur(8px)' });
    if (wipe) gsap.set(wipe, { autoAlpha: 1 });
    if (headingTitle) gsap.set(headingTitle, { autoAlpha: 0, y: 14 });
    if (wheel) gsap.set(wheel, { autoAlpha: 0 });
    if (cardsOrbit) gsap.set(cardsOrbit, { autoAlpha: 0 });

    const bridgeEnterM = gsap.timeline({
      scrollTrigger: { trigger: section, start: 'top 82%', end: 'top 5%', scrub: 2.2, invalidateOnRefresh: true }
    });
    bridgeEnterM
      .to(bridge, { autoAlpha: 1, duration: 0.14 }, 0)
      .to(trackSub, { autoAlpha: 1, duration: 0.18 }, 0.04)
      .to(trackMain, { autoAlpha: 1, duration: 0.18 }, 0.06)
      .fromTo(pulseSub, { strokeDashoffset: 1040 }, { strokeDashoffset: -260, duration: 0.78, ease: 'none' }, 0)
      .fromTo(pulseSubGhost, { strokeDashoffset: 1040 }, { strokeDashoffset: -340, duration: 0.78, ease: 'none' }, 0.06)
      .fromTo(pulseMain, { strokeDashoffset: 1000 }, { strokeDashoffset: -300, duration: 0.78, ease: 'none' }, 0.03)
      .fromTo(pulseMainGhost, { strokeDashoffset: 1000 }, { strokeDashoffset: -380, duration: 0.78, ease: 'none' }, 0.09)
      .to(sideLeftM, { autoAlpha: 1, y: 0, duration: 0.28, ease: 'power2.out' }, 0.10)
      .to(sideRightM, { autoAlpha: 1, y: 0, duration: 0.28, ease: 'power2.out' }, 0.10)
      .to(sideLeftM, { y: '36vh', duration: 0.42, ease: 'power1.inOut' }, 0.60)
      .to(sideRightM, { y: '-36vh', duration: 0.42, ease: 'power1.inOut' }, 0.60)
      .to([sideLeftM, sideRightM], { autoAlpha: 0, duration: 0.30, ease: 'power1.out' }, 0.72)
      .to(bridge, { autoAlpha: 0, duration: 0.18 }, 0.84)
      .to([trackSub, trackMain], { autoAlpha: 0, duration: 0.14 }, '<')
      .to(wipe, { autoAlpha: 0, duration: 0.16 }, 0.04);

    const pinnedM = gsap.timeline({
      scrollTrigger: {
        trigger: section,
        start: 'top top',
        end: '+=65%',
        pin,
        pinSpacing: true,
        scrub: 1,
        invalidateOnRefresh: true,
        onRefresh: updateWheelMobile,
      }
    });
    pinnedM
      .fromTo(stage, { autoAlpha: 0, filter: 'blur(10px)' }, { autoAlpha: 1, filter: 'blur(0px)', duration: 0.10 }, 0)
      // Título aparece en el centro tras el fade de kickers y queda fijo sobre el mini plato (como imagen de referencia)
      .fromTo(headingTitle, { autoAlpha: 0, y: 10 }, { autoAlpha: 1, y: 0, duration: 0.12 }, 0.02)
      .to(wheel, { autoAlpha: 1, duration: 0.16 }, 0.18)
      .to(cardsOrbit, { autoAlpha: 1, duration: 0.16, onComplete: updateWheelMobile }, 0.20);

    // Arrastre horizontal gira solo el plato
    let isDragging = false, startX = 0, startRot = 0;
    const dragTarget = stage;
    dragTarget.style.touchAction = 'pan-y';
    dragTarget.style.cursor = 'grab';
    dragTarget.addEventListener('pointerdown', (e) => {
      isDragging = true; startX = e.clientX; startRot = state.rotation;
      dragTarget.setPointerCapture(e.pointerId); dragTarget.style.cursor = 'grabbing';
    });
    const onMove = (e) => {
      if (!isDragging) return;
      const dx = e.clientX - startX;
      state.rotation = startRot + dx * 0.45;
      updateWheelMobile();
    };
    const onUp = () => {
      if (!isDragging) return;
      isDragging = false; dragTarget.style.cursor = 'grab';
      // snap al más cercano
      const snapIndex = Math.round(-state.rotation / step);
      const clamped = gsap.utils.clamp(0, cards.length - 1, snapIndex);
      gsap.to(state, { rotation: -clamped * step, duration: 0.45, ease: 'power2.out', onUpdate: updateWheelMobile });
    };
    dragTarget.addEventListener('pointermove', onMove);
    dragTarget.addEventListener('pointerup', onUp);
    dragTarget.addEventListener('pointercancel', onUp);
    dragTarget.addEventListener('pointerleave', onUp);
    // soporte touch
    dragTarget.addEventListener('touchstart', (e) => { startX = e.touches[0].clientX; startRot = state.rotation; }, { passive: true });
    dragTarget.addEventListener('touchmove', (e) => { state.rotation = startRot + (e.touches[0].clientX - startX) * 0.45; updateWheelMobile(); }, { passive: true });

    window.addEventListener('resize', updateWheelMobile);
    updateWheelMobile();
  }
</script>
