---
import about1 from '../assets/aboutus1.jpg';
import about2 from '../assets/aboutus2.jpg';
---

<div class="landing-sequence" data-narrative>
  <section id="flow" class="flow" data-flow aria-label="Secuencia del tubo">
    <div id="about" class="f7-anchor" style="top:2600px"></div>
    <div id="especialidades" class="f7-anchor" style="top:8000px"></div>
    <div class="stage" data-stage>
      <svg class="pipe" data-pipe viewBox="86 120 650 137" preserveAspectRatio="none" shape-rendering="geometricPrecision" aria-hidden="true">
        <path fill="currentColor" d="M399 122 C450 121 506 120 555 120 C584 120 605 130 630 145 C665 167 700 207 736 257 C711 257 681 255 650 255 C638 255 627 255 617 255 C607 237 593 220 576 210 C556 197 535 196 510 196 C463 196 414 196 365 196 C315 196 265 196 220 196 C198 196 177 199 163 211 C153 220 149 233 146 245 C126 245 105 245 86 244 C94 217 107 191 124 169 C143 147 168 134 198 128 C229 122 266 124 300 123 C335 123 368 122 399 122 Z"/>
      </svg>

      <div class="act continuum-statement" data-statement>
        <p>DONDE LOS MÉTODOS CONVENCIONALES<br>ALCANZAN SU LÍMITE,<br><span class="continuum-red">SIMICO TOMA EL CONTROL.</span></p>
      </div>

      <div class="act continuum-about" data-about>
        <div class="continuum-about-wordmark" data-wordmark>SIMICO</div>
        <div class="continuum-about-copy" data-copy>
          <p>SIMICO es una empresa mexicana de servicios industriales para el sector energético. Trabajamos por proyectos: recibimos misiones técnicas complejas y las llevamos a término con control, plan claro y ejecución certificada de principio a fin.</p>
          
        </div>
        <div class="continuum-about-plate" data-plate><b>SIMICO / SERVICIOS INDUSTRIALES</b>TABASCO, MX<br>INGENIERÍA · MANTENIMIENTO · CONSTRUCCIÓN</div>
        <a class="continuum-about-cta" href="#especialidades" data-cta>Conocer la operación →</a>
        <img class="continuum-about-photo one" data-photo-one src={about1.src} alt="Operación nocturna de SIMICO con personal en campo y antorcha de planta" loading="lazy">
        <img class="continuum-about-photo two" data-photo-two src={about2.src} alt="Izaje de equipo industrial por personal de SIMICO" loading="lazy">
      </div>

      <div class="plant" data-plant aria-hidden="true"></div>
      <div class="plant is-red" data-plant-red aria-hidden="true"></div>

      <div class="spec-block" data-spec-block style="left:9%;top:19%">
        <span class="num">01</span>
        <h4>Ingeniería</h4>
        <div class="spec-copy">
          <p class="body-red" data-spec-red>La misión compleja se resuelve antes de mover un equipo.</p>
          <p class="body-ink" data-spec-ink>La misión compleja se resuelve antes de mover un equipo.</p>
        </div>
        <span class="leader"></span>
      </div>
      <div class="spec-block" data-spec-block style="left:39%;top:34%">
        <span class="num">02</span>
        <h4>Mantenimiento</h4>
        <div class="spec-copy">
          <p class="body-red" data-spec-red>La operación continúa: cada paro se planea.</p>
          <p class="body-ink" data-spec-ink>La operación continúa: cada paro se planea.</p>
        </div>
        <span class="leader"></span>
      </div>
      <div class="spec-block" data-spec-block style="left:69%;top:15%">
        <span class="num">03</span>
        <h4>Construcción</h4>
        <div class="spec-copy">
          <p class="body-red" data-spec-red>La obra se entrega como se aprobó.</p>
          <p class="body-ink" data-spec-ink>La obra se entrega como se aprobó.</p>
        </div>
        <span class="leader"></span>
      </div>
      <div class="flood" data-flood aria-hidden="true"><span class="line"></span></div>

    </div>
    <div class="content-anchor" data-content-anchor aria-hidden="true"></div>
    <div class="color-anchor" data-color-anchor aria-hidden="true"></div>
    <div class="spec-anchor" data-spec-anchor aria-hidden="true"></div>
  </section>



<svg class="icon-defs" aria-hidden="true" focusable="false">
  <symbol id="svc-redes" viewBox="0 0 24 24">
    <path fill="currentColor" fill-rule="evenodd" d="M12 2 7.2 22h2.7l1-5h2.2l1 5h2.7L12 2Zm-1.5 7.5h3l.7 3H9.8l.7-3Zm-.7 5h3.6l.6 2.7h-4.8l.6-2.7Z"/>
    <rect x="2" y="7.7" width="20" height="1.6" fill="currentColor"/>
    <rect x="0" y="6.9" width="2.8" height="1.2" fill="currentColor"/>
    <rect x="21.2" y="6.9" width="2.8" height="1.2" fill="currentColor"/>
    <rect x="4.5" y="13" width="15" height="1.4" fill="currentColor"/>
  </symbol>
  <symbol id="svc-caminos" viewBox="0 0 24 24">
    <rect x="2" y="16" width="20" height="3" fill="currentColor"/>
    <path fill="currentColor" d="M3 16C6.5 6.8 17.5 6.8 21 16h-2.3C15.8 9.8 8.2 9.8 5.3 16H3Z"/>
    <rect x="4.8" y="19" width="2.2" height="3.2" fill="currentColor"/>
    <rect x="17" y="19" width="2.2" height="3.2" fill="currentColor"/>
    <rect x="11.4" y="16" width="1.2" height="3" fill="currentColor"/>
  </symbol>
  <symbol id="svc-tuberias" viewBox="0 0 24 24">
    <rect x="3" y="10" width="18" height="4" fill="currentColor"/>
    <path fill="currentColor" fill-rule="evenodd" d="M2 8h3v8H2V8Zm1.1 2.2h.9v3.6h-.9v-3.6ZM19 8h3v8h-3V8Zm1.1 2.2h.9v3.6h-.9v-3.6Z"/>
    <rect x="11" y="6.2" width="2" height="3.8" fill="currentColor"/>
    <circle cx="12" cy="5.2" r="2" fill="currentColor"/>
  </symbol>
  <symbol id="svc-soldadura" viewBox="0 0 24 24">
    <path fill="currentColor" fill-rule="evenodd" d="M7 3h10l3 3 1 6-1 6c-1 3-4 4-7 4h-3c-3 0-6-2-7-5l-1-5 1-6 3-3Zm1 6v5h8V9H8Z"/>
    <rect x="9" y="1" width="8" height="3" rx="1" fill="currentColor"/>
    <rect x="0" y="10" width="3" height="3" fill="currentColor"/>
    <rect x="21" y="10" width="3" height="3" fill="currentColor"/>
    <rect x="8" y="16" width="8" height="1.2" fill="currentColor"/>
    <rect x="10.5" y="18.2" width="3" height="1.2" fill="currentColor"/>
    </symbol>
  <symbol id="svc-civil" viewBox="0 0 24 24">
    <path fill="currentColor" d="M3.2 8.6 12.1 4l4.1 8-8.9 4.6-4.1-8Z"/>
    <path fill="currentColor" d="M15.6 3.4 19 1.8l2.6 5.2-3.4 1.6-2.6-5.2Z"/>
    <rect x="3" y="19" width="18" height="3" fill="currentColor"/>
    <rect x="3" y="16.3" width="8.4" height="2.4" fill="currentColor"/>
    <rect x="12.6" y="16.3" width="8.4" height="2.4" fill="currentColor"/>
  </symbol>
  <symbol id="svc-mecanica" viewBox="0 0 24 24">
    <path fill="currentColor" fill-rule="evenodd" d="M8 2h8v3.2h-1.8v3c0 3.2 5 3.2 5 7.2 0 4.5-3.2 6.6-7.2 6.6-3.1 0-6-2-6-5h3c0 1.6 1.1 2.4 3 2.4 2.3 0 4.2-1.3 4.2-3.8 0-2.6-4.8-3-4.8-7.3V5.2H8V2Zm3 1.2v1h2v-1h-2Z"/>
  </symbol>
</svg>

<div id="f5">
<section class="services-flow" data-flow aria-label="Carrusel de servicios">
    <div class="f5-stage" data-stage>
      <div class="carousel" data-carousel>
      <div class="disc" aria-hidden="true"></div>
      <div class="sector-lines" data-lines aria-hidden="true">
        <span style="transform:rotate(0deg)"></span>
        <span style="transform:rotate(60deg)"></span>
        <span style="transform:rotate(120deg)"></span>
        <span style="transform:rotate(180deg)"></span>
        <span style="transform:rotate(240deg)"></span>
        <span style="transform:rotate(300deg)"></span>
      </div>
      <div class="title-pill"><h1>Nuestros<br>Servicios</h1></div>
      <div class="labels" data-labels>
        <article class="svc" data-label="Tendido de redes eléctricas">
          <h3>Tendido de redes eléctricas</h3>
          <svg class="svc-icon" aria-hidden="true"><use href="#svc-redes"/></svg>
        </article>
        <article class="svc" data-label="Caminos y puentes">
          <h3>Caminos y puentes</h3>
          <svg class="svc-icon" aria-hidden="true"><use href="#svc-caminos"/></svg>
        </article>
        <article class="svc" data-label="Tendido de tuberías de proceso">
          <h3>Tendido de tuberías de proceso</h3>
          <svg class="svc-icon" aria-hidden="true"><use href="#svc-tuberias"/></svg>
        </article>
        <article class="svc" data-label="Soldadura industrial">
          <h3>Soldadura industrial</h3>
          <svg class="svc-icon" aria-hidden="true"><use href="#svc-soldadura"/></svg>
        </article>
        <article class="svc" data-label="Obra civil">
          <h3>Obra civil</h3>
          <svg class="svc-icon" aria-hidden="true"><use href="#svc-civil"/></svg>
        </article>
        <article class="svc" data-label="Obra mecánica y montaje industrial">
          <h3>Obra mecánica y montaje industrial</h3>
          <svg class="svc-icon" aria-hidden="true"><use href="#svc-mecanica"/></svg>
        </article>
      </div>
      </div>
      <nav class="f5-nav" data-nav aria-label="Navegación del carrusel de servicios">
        <button type="button" data-prev><span aria-hidden="true">←</span> Anterior</button>
        <button type="button" data-next>Siguiente <span aria-hidden="true">→</span></button>
      </nav>
    </div>
    <div id="servicios" class="step-anchor" data-step-anchor aria-hidden="true"></div>
  </section>
</div>

  <div class="landing-bridge" data-pixel-bridge>
    <div class="f7-red-hold" aria-hidden="true"></div>
<div id="f6">
<section class="services-end" data-services-end aria-label="Final de Services y grid pixel">
    <div class="grid-wrap" data-grid aria-hidden="true"></div>
  </section>
  </div>

</div>
</div>

<style>
  .landing-sequence{
    --ink:#232529;
    --paper:#fffef5;
    --gray:#b6b9bd;
    --mono:Consolas,"Courier New",monospace; --sans:Arial,Helvetica,sans-serif;
    --pipe:#232529;
    --ring:#f7efed;
  }

  html{scroll-behavior:auto}
  body{overflow-x:clip}
  .icon-defs{position:absolute;width:0;height:0;overflow:hidden}

  /* Secuencia pineada: el escenario es el mismo durante 1220vh */
  .flow{position:relative;height:1220vh;background:var(--paper)}
  .stage{position:sticky;top:0;height:100vh;overflow:hidden;background:var(--paper);isolation:isolate}
  .stage::before{content:"";position:absolute;inset:0;background-image:linear-gradient(#23252908 1px,transparent 1px),linear-gradient(90deg,#23252908 1px,transparent 1px);background-size:44px 44px;z-index:0}

  /* El tubo: silueta vectorial única; rota y se aleja hasta la tubería de la refinería */
  .pipe{
    position:absolute;z-index:2;left:7.6%;top:73.2%;width:61.2%;height:23.1%;
    display:block;overflow:visible;pointer-events:none;color:var(--pipe);
    transform-origin:50% 50%;will-change:transform,opacity;
  }

  /* Contenido de actos */
  .act{position:absolute;z-index:5;inset:0;pointer-events:none}
  .continuum-statement{display:grid;place-items:center;padding:0 9vw;text-align:center;color:var(--paper)}
  .continuum-statement p{margin:0;font:800 clamp(2rem,4.6vw,4.6rem)/1.08 var(--sans);letter-spacing:-.01em;max-width:1180px}
  .continuum-statement .continuum-red{color:var(--red)}

  .continuum-about{color:var(--paper)}
  .continuum-about-wordmark{position:absolute;left:50%;top:18%;transform:translateX(-50%);font:300 clamp(2.2rem,4.8vw,4.6rem)/1 var(--sans);letter-spacing:.28em;color:var(--paper);opacity:.95}
  .continuum-about-copy{position:absolute;left:35.6%;top:36%;width:29%;color:var(--paper);font:400 clamp(.78rem,1.02vw,1rem)/1.5 var(--mono);text-align:left}
  .continuum-about-copy p{margin:0 0 1.1em}
  .continuum-about-plate{position:absolute;left:35.6%;bottom:30%;width:29%;border:1px solid var(--paper);padding:12px 14px;color:var(--paper);font:400 clamp(.62rem,.78vw,.82rem)/1.55 var(--mono);letter-spacing:.02em;background:#232529}
  .continuum-about-plate b{display:block;color:#fff;font-weight:700;letter-spacing:.06em;margin-bottom:3px}
  .continuum-about-cta{position:absolute;left:35.6%;bottom:25%;color:var(--paper);font:700 clamp(.7rem,.86vw,.9rem)/1 var(--mono);letter-spacing:.06em;text-decoration:none;border-bottom:1px solid var(--paper);padding-bottom:4px}
  .continuum-about-photo{position:absolute;z-index:6;object-fit:cover;border:1px solid #232529;will-change:transform,opacity;pointer-events:none}
  .continuum-about-photo.one{left:5.6%;top:10.2%;width:19.4%;height:46.1%;object-position:center 35%}
  .continuum-about-photo.two{right:5.7%;top:45.8%;width:18.8%;height:45.8%;object-position:center 25%}

  /* Planta: máscara desde /refineria.svg; se estira al escenario para alinear con la tubería final */
  .plant{
    position:absolute;z-index:1;inset:0;background:currentColor;
    -webkit-mask-image:linear-gradient(#fff,#fff),url('/refineria.svg');
    mask-image:linear-gradient(#fff,#fff),url('/refineria.svg');
    -webkit-mask-mode:luminance,luminance;
    mask-mode:luminance,luminance;
    -webkit-mask-size:100% 100%;
    mask-size:100% 100%;
    -webkit-mask-repeat:no-repeat;
    mask-repeat:no-repeat;
    -webkit-mask-composite:xor;
    mask-composite:exclude;
    opacity:0;color:var(--gray);pointer-events:none;will-change:opacity
  }
  .plant.is-red{color:var(--red);opacity:0}

  /* F4 · About + Specialties */
  .content-anchor{position:absolute;top:772.8vh;left:0;width:1px;height:1px;pointer-events:none}
  .color-anchor{position:absolute;top:851.2vh;left:0;width:1px;height:1px;pointer-events:none}
  .spec-anchor{position:absolute;top:880vh;left:0;width:1px;height:1px;pointer-events:none}
  .spec-block{position:absolute;z-index:6;width:23vw;padding:12px 14px;background:linear-gradient(180deg,rgba(255,254,245,.95),rgba(255,254,245,.8));color:var(--ink);font:400 clamp(.7rem,.82vw,.92rem)/1.4 var(--mono);opacity:0;will-change:transform,opacity;pointer-events:none}
  .spec-block .num{display:block;font:700 10px/1 var(--mono);letter-spacing:.08em;color:var(--red);margin-bottom:8px}
  .spec-block h4{margin:0 0 6px;font:800 clamp(1.25rem,1.9vw,2rem)/.95 var(--sans);letter-spacing:-.02em}
  .spec-copy{display:grid}
  .spec-copy p{grid-area:1/1;margin:0}
  .spec-copy .body-ink{opacity:0}
  .spec-block .leader{position:absolute;left:14px;top:100%;width:1px;height:9vh;background:#23252955}
  .spec-block .leader::after{content:"";position:absolute;left:0;top:100%;width:4vw;height:1px;background:#23252955}
  .flood{position:absolute;z-index:3;left:0;right:0;bottom:0;height:100%;background:var(--red);will-change:transform;pointer-events:none}
  .flood .line{position:absolute;left:0;right:0;top:0;height:1px;background:#fff3}

  /* Modo captura estática: ?static=1&p=0.32 */
  :global(.static-preview) .flow{height:100vh}
  :global(.static-preview) .stage{position:relative}

  /* Reduced motion y móvil: secuencia estática, sin pin */
  :global(.reduced) .flow{height:auto}
  :global(.reduced) .stage{position:relative;height:auto;min-height:100vh;overflow:visible}
  :global(.reduced) .pipe{position:relative;left:auto;top:auto;width:100vw;height:100vh;background:var(--pipe);transform:none!important;opacity:1!important}
  :global(.reduced) .continuum-statement,:global(.reduced) .continuum-about{position:relative;inset:auto;min-height:100vh;display:block;padding:10vh 9vw;opacity:1!important;transform:none!important}
  :global(.reduced) .continuum-about-wordmark,:global(.reduced) .continuum-about-copy,:global(.reduced) .continuum-about-plate,:global(.reduced) .continuum-about-cta,:global(.reduced) .continuum-about-photo{position:relative;left:auto;right:auto;top:auto;bottom:auto;width:auto;margin:0 0 20px}
  :global(.reduced) .continuum-about-photo{width:min(340px,80vw);height:auto;aspect-ratio:3/4}
  :global(.reduced) .plant{position:relative;height:80vh;opacity:1!important}
  :global(.reduced) .plant.is-red{display:none}
  :global(.reduced) .spec-block{position:relative;left:auto!important;top:auto!important;width:auto;margin:0 0 20px;opacity:1!important;background:rgba(255,254,245,.95)}
  :global(.reduced) .spec-copy .body-ink{opacity:1}
  :global(.reduced) .spec-copy .body-red{display:none}
  :global(.reduced) .flood{position:relative;height:34vh;transform:none!important;opacity:1!important}

  @media (max-width:767px){
    .continuum-about-copy{left:8%;width:70%;top:42%}
    .continuum-about-plate{left:8%;width:70%;bottom:22%}
    .continuum-about-cta{left:8%;bottom:13%}
    .continuum-about-photo.one{left:8%;top:18%;width:26%;height:26%}
    .continuum-about-photo.two{right:8%;top:50%;width:25%;height:26%}
    .continuum-statement p{font-size:clamp(1.7rem,7vw,2.6rem)}
    .spec-block{width:78%;background:rgba(255,254,245,.96)}
    .spec-block .leader{display:none}
  }

  .services-flow{position:relative;height:480vh;background:var(--red)}
  .step-anchor{position:absolute;left:0;top:100vh;width:1px;height:1px;pointer-events:none}
  .f5-stage{position:sticky;z-index:3;top:0;height:100vh;overflow:visible;background:var(--red);isolation:isolate}

  .carousel{position:absolute;z-index:1;inset:0;transform:scale(1.2);transform-origin:50% 0;pointer-events:none}
  .disc{position:absolute;z-index:1;left:50%;top:0;width:91vw;height:91vw;background:var(--ring);border-radius:50%;transform:translate(-50%,-50%)}
  .sector-lines{position:absolute;z-index:2;left:50%;top:0;width:0;height:0;transform-origin:0 0;will-change:transform}
  .sector-lines span{position:absolute;left:0;top:0;width:45.5vw;height:1px;background:rgba(35,37,41,.4);transform-origin:left center}
  .title-pill{position:absolute;z-index:6;left:50%;top:0;width:30vw;height:42vh;transform:translate(-50%,-50%);background:var(--red);border-radius:50%;pointer-events:none}
  .title-pill h1{position:absolute;left:50%;top:30.5vh;width:92%;margin:0;transform:translate(-50%,-50%);color:#fff;text-align:center;font:800 clamp(2.4rem,3.8vw,4.8rem)/.9 var(--sans);letter-spacing:-.04em}

  .labels{position:absolute;z-index:4;inset:0;pointer-events:none}
  .svc{position:absolute;left:50%;top:0;display:block;width:16vw;color:var(--ink);text-align:center;transform:translate(-50%,-50%);opacity:0;will-change:transform,opacity}
  .svc h3{margin:0;font:800 clamp(.95rem,1.25vw,1.4rem)/1.04 var(--sans);letter-spacing:-.025em}
  .svc.is-active h3{font-size:clamp(1.1rem,1.65vw,1.85rem)}
  .svc-icon{position:absolute;left:50%;top:100%;width:3vw;height:3vw;margin-top:.9vh;transform:translateX(-50%);color:var(--ink)}
  .svc.is-active .svc-icon{width:3.4vw;height:3.4vw}

  .f5-nav{position:absolute;z-index:11;left:2.5vw;right:2.5vw;bottom:5.5vh;display:flex;justify-content:space-between;pointer-events:none}
  .f5-nav button{border:0;padding:.75rem 0;background:transparent;color:var(--paper);cursor:pointer;font:700 .82vw/1 var(--mono);letter-spacing:.04em;text-transform:uppercase;pointer-events:auto}
  .f5-nav button span{margin:0 .45rem;font-size:1rem}
  .f5-nav button:disabled{cursor:default;opacity:.32}
  .f5-nav button:hover:not(:disabled){text-decoration:underline}

  :global(.reduced) .services-flow{height:auto}
  :global(.reduced) .f5-stage{position:relative;height:auto;min-height:100vh;overflow:visible;padding:8vh 6vw}
  :global(.reduced) .carousel{position:relative;inset:auto;transform:none;pointer-events:auto}
  :global(.reduced) .disc,:global(.reduced) .sector-lines{display:none}
  :global(.reduced) .title-pill{position:relative;left:auto;top:auto;width:auto;height:auto;transform:none;background:transparent;border-radius:0;margin:0 0 6vh;pointer-events:auto}
  :global(.reduced) .title-pill h1{position:relative;left:auto;top:auto;width:auto;transform:none;color:var(--paper);font-size:clamp(2.4rem,7vw,4.2rem)}
  :global(.reduced) .labels{position:relative;inset:auto;display:grid;grid-template-columns:repeat(2,1fr);gap:24px 28px;pointer-events:auto}
  :global(.reduced) .svc{position:relative!important;left:auto!important;top:auto!important;width:auto;opacity:1!important;transform:none!important}
  :global(.reduced) .svc h3{font-size:1.1rem}
  :global(.reduced) .svc-icon{width:34px;height:34px}
  :global(.reduced) .f5-nav{display:none}

  @media (max-width:767px){
    :global(.reduced) .labels{grid-template-columns:1fr}
  }

  #f6{position:relative;z-index:1;--paper:#f8f9fa}
  .services-end{position:relative;min-height:100vh;overflow:hidden;background:var(--red)}
  .grid-wrap{position:absolute;z-index:2;left:0;right:0;bottom:0;height:25vw;background:var(--red);display:grid;grid-template-columns:repeat(24,1fr);grid-template-rows:repeat(6,1fr)}
  .grid-wrap :global(.cell){position:relative;display:block;background:var(--red);overflow:hidden}
  .grid-wrap :global(.cell)::before{content:"";position:absolute;inset:0;background:var(--paper);opacity:0;transform:scale(.72);transition:opacity .32s ease,transform .32s ease}
  .grid-wrap :global(.cell.is-white)::before{opacity:1;transform:scale(1)}
  .grid-wrap :global(.cell:nth-child(3n))::after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 0 1px #ea322114;pointer-events:none}

  .f7-anchor{position:absolute;left:0;width:1px;height:1px;pointer-events:none}
  .f7-red-hold{position:relative;height:100vh;background:var(--red)}
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
    const flow = document.querySelector('[data-flow]');
    const pipe = document.querySelector('[data-pipe]');
    const statement = document.querySelector('[data-statement]');
    const about = document.querySelector('[data-about]');
    const photos = [...document.querySelectorAll('.continuum-about-photo')];
    const copy = document.querySelector('[data-copy]');
    const wordmark = document.querySelector('[data-wordmark]');
    const plate = document.querySelector('[data-plate]');
    const cta = document.querySelector('[data-cta]');
    const plant = document.querySelector('[data-plant]');
    const plantRed = document.querySelector('[data-plant-red]');
    const specAnchor = document.querySelector('[data-spec-anchor]');
    const contentAnchor = document.querySelector('[data-content-anchor]');
    const colorAnchor = document.querySelector('[data-color-anchor]');
    const specBlocks = [...document.querySelectorAll('[data-spec-block]')];
    const specBodiesRed = [...document.querySelectorAll('[data-spec-red]')];
    const specBodiesInk = [...document.querySelectorAll('[data-spec-ink]')];
    const flood = document.querySelector('[data-flood]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 768px)').matches;

    const pipeTarget = () => {
      const cs = getComputedStyle(pipe);
      return {
        left: parseFloat(cs.left),
        top: parseFloat(cs.top),
        width: parseFloat(cs.width),
        height: parseFloat(cs.height)
      };
    };
    const pipeBand = () => (76 / 137) * pipeTarget().height;
    const pipeOffset = () => (30.5 / 137) * pipeTarget().height;
    const pipeBaseScale = () => window.innerWidth / pipeBand();
    const pipeStartScale = () => pipeBaseScale() * 1.06;
    const pipeAboutScale = () => pipeBaseScale() * .589;
    const pipeState = (scale) => {
      const target = pipeTarget();
      return {
        rotation: 90,
        scale,
        x: window.innerWidth / 2 - (target.left + target.width / 2) - pipeOffset() * scale,
        y: window.innerHeight / 2 - (target.top + target.height / 2)
      };
    };

    if (reduced || !desktop) {
      document.body.classList.add('reduced');
      statement.style.opacity = '1';
      about.style.opacity = '1';
      plant.style.opacity = '1';
    } else {
      gsap.registerPlugin(ScrollTrigger);
      gsap.set(statement, { autoAlpha: 0, y: 22 });
      gsap.set(about, { autoAlpha: 0 });
      gsap.set([wordmark, copy, plate, cta], { autoAlpha: 0, y: 16 });
      gsap.set(photos, { autoAlpha: 0 });
      gsap.set(photos[0], { x: -36 });
      gsap.set(photos[1], { x: 36 });
      gsap.set(plant, { autoAlpha: 0 });
      gsap.set(pipe, { autoAlpha: 1, transformOrigin: '50% 50%', ...pipeState(pipeStartScale()) });
      gsap.set(specBlocks, { autoAlpha: 0, y: 18 });
      gsap.set(specBodiesRed, { autoAlpha: 1 });
      gsap.set(specBodiesInk, { autoAlpha: 0 });
      gsap.set(plantRed, { autoAlpha: 0 });
      gsap.set(flood, { yPercent: 100, autoAlpha: 1 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: flow,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 8.8,
          scrub: 1.15,
          invalidateOnRefresh: true
        }
      });

      window.__f3tl = tl;
      tl
        .to(statement, { autoAlpha: 1, y: 0, duration: .04 }, 0)
        .to(statement, { autoAlpha: 0, duration: .04 }, .09)
        .to(pipe, {
          scale: () => pipeAboutScale(),
          x: () => pipeState(pipeAboutScale()).x,
          y: () => pipeState(pipeAboutScale()).y,
          duration: .16,
          ease: 'none'
        }, .10)
        .to(about, { autoAlpha: 1, duration: .05 }, .24)
        .to(wordmark, { autoAlpha: 1, y: 0, duration: .05 }, .24)
        .to(photos, { autoAlpha: 1, x: 0, duration: .07, stagger: .02, ease: 'power2.out' }, .25)
        .to([copy, plate, cta], { autoAlpha: 1, y: 0, duration: .06, stagger: .02, ease: 'power2.out' }, .27)
        .to({}, { duration: .19 })
        .to(photos, { autoAlpha: 0, x: (i) => i ? 36 : -36, duration: .05, ease: 'power1.in' }, .50)
        .to([wordmark, copy, plate, cta], { autoAlpha: 0, y: -28, duration: .05, ease: 'power1.in' }, .50)
        .to(pipe, { rotation: 0, scale: 1, x: 0, y: 0, duration: .24, ease: 'power2.inOut' }, .52)
        .to(about, { autoAlpha: 0, duration: .04 }, .54)
        .to(plant, { autoAlpha: 1, duration: .03, ease: 'none' }, .76)
        .to(pipe, { autoAlpha: 0, duration: .03 }, .78)
        .to({}, { duration: .22 });

      ScrollTrigger.addEventListener('refreshInit', () => {
        if (tl.progress() < .10) gsap.set(pipe, pipeState(pipeStartScale()));
      });

      const contentTl = gsap.timeline({
        scrollTrigger: {
          trigger: contentAnchor,
          start: 'top top',
          end: () => '+=' + window.innerHeight * .112,
          scrub: 1,
          invalidateOnRefresh: true
        }
      });
      window.__f4content = contentTl;
      contentTl.to(specBlocks, { autoAlpha: 1, y: 0, duration: .08, stagger: .015, ease: 'power2.out' }, 0);

      const colorTl = gsap.timeline({
        scrollTrigger: {
          trigger: colorAnchor,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 1.008,
          scrub: 1.1,
          invalidateOnRefresh: true
        }
      });
      window.__f4color = colorTl;
      colorTl
        .to(plantRed, { autoAlpha: 1, duration: .14, ease: 'none' }, 0)
        .to(plant, { autoAlpha: 0, duration: .14, ease: 'none' }, 0)
        .to(specBodiesRed, { autoAlpha: 0, duration: .14, ease: 'none' }, 0)
        .to(specBodiesInk, { autoAlpha: 1, duration: .14, ease: 'none' }, 0);

      const specTl = gsap.timeline({
        scrollTrigger: {
          trigger: specAnchor,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 2.4,
          scrub: 1.1,
          invalidateOnRefresh: true
        }
      });
      window.__f4spec = specTl;
      specTl
        .to(specBlocks, { autoAlpha: 0, y: -10, duration: .08, stagger: .01, ease: 'power1.in' }, .42)
        .to(flood, { yPercent: 0, duration: .36, ease: 'none' }, .60)
        .to({}, { duration: .04 });
    }

    // Debug de captura: ?static=1&p=0.32 (F3) · ?static=1&s=0.30 (F4)
    const params = new URLSearchParams(location.search);
    const debugP = Number(params.get('p'));
    const debugS = Number(params.get('s'));
    const staticPreview = params.get('static') === '1';
    const hasP = Number.isFinite(debugP) && debugP > 0;
    const hasS = params.has('s') && Number.isFinite(debugS);
    if (staticPreview) document.body.classList.add('static-preview');
    if (!reduced && desktop && (hasP || hasS) && window.__f3tl) {
      requestAnimationFrame(() => {
        if (staticPreview) {
          [window.__f3tl, window.__f4content, window.__f4color, window.__f4spec].forEach(tl => {
            if (!tl) return;
            tl.scrollTrigger?.kill();
            tl.scrollTrigger = null;
            tl.pause();
          });
        } else {
          const y = hasS ? specAnchor.getBoundingClientRect().top + window.scrollY : flow.offsetTop;
          window.scrollTo(0, y);
        }
        const overall = hasS
          ? Math.round((8.8 + Math.min(1, Math.max(0, debugS)) * 2.4) / 11.2 * 100)
          : Math.round(Math.min(1, Math.max(0, debugP)) * 8.8 / 11.2 * 100);
        if (hasS) window.__f3tl.progress(1).pause();
        else window.__f3tl.progress(Math.min(1, Math.max(0, debugP))).pause();
        if (window.__f4content) window.__f4content.progress(overall >= 70 ? 1 : 0).pause();
        if (window.__f4color) window.__f4color.progress(Math.min(1, Math.max(0, (overall - 76) / 9))).pause();
        if (window.__f4spec) window.__f4spec.progress(hasS ? Math.min(1, Math.max(0, debugS)) : 0).pause();
      });
    }

(() => {
  const root = document.querySelector('#f5');

  const flow = root.querySelector('[data-flow]');
  const carousel = root.querySelector('[data-carousel]');
  const stepAnchor = root.querySelector('[data-step-anchor]');
  const lines = root.querySelector('[data-lines]');
  const labels = [...root.querySelectorAll('[data-label]')];
  const prev = root.querySelector('[data-prev]');
  const next = root.querySelector('[data-next]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 768px)').matches;
  const step = 360 / labels.length;
  const state = { rotation: 0 };
  let activeIndex = 0;

  const update = () => {
    const measured = labels.map((el, index) => {
      const angle = 90 + index * step + state.rotation;
      const rad = angle * Math.PI / 180;
      const dist = Math.abs((((angle - 90) % 360) + 540) % 360 - 180);
      return { el, index, angle, rad, dist };
    });
    activeIndex = measured.reduce((best, item) => item.dist < best.dist ? item : best, measured[0]).index;
    measured.forEach(({ el, index, angle, dist }) => {
      const isActive = index === activeIndex;
      const isSide = dist < 90;
      const radius = isActive ? 18.3 : 22.4;
      const rad = angle * Math.PI / 180;
      const x = 50 + Math.cos(rad) * radius;
      let y = 0 + Math.sin(rad) * radius;
      if (isSide && !isActive) y -= 2.8;
      gsap.set(el, {
        left: x + 'vw',
        top: y + 'vw',
        xPercent: -50,
        yPercent: -50,
        opacity: isActive ? 1 : isSide ? .82 : 0,
        scale: isActive ? 1 : isSide ? .9 : .82,
        zIndex: isActive ? 20 : isSide ? 10 : 0
      });
      el.classList.toggle('is-active', isActive);
    });
    gsap.set(lines, { rotation: state.rotation });
    prev.disabled = activeIndex === 0;
    next.disabled = activeIndex === labels.length - 1;
  };

  let navigateToCard = (index) => {
    const target = Math.max(0, Math.min(labels.length - 1, index));
    gsap.to(state, { rotation: -step * target, duration: .65, ease: 'power2.inOut', onUpdate: update });
  };

  prev.addEventListener('click', () => navigateToCard(activeIndex - 1));
  next.addEventListener('click', () => navigateToCard(activeIndex + 1));

  if (reduced || !desktop) {
    document.body.classList.add('reduced');
    labels.forEach(el => el.classList.remove('is-active'));
  } else {
    gsap.registerPlugin(ScrollTrigger);
    gsap.set(carousel, { autoAlpha: 0, scale: .94 });
    gsap.set(root.querySelector('[data-nav]'), { autoAlpha: 0 });
    update();

    const entry = gsap.timeline({
      scrollTrigger: {
        trigger: flow,
        start: 'top top',
        end: () => '+=' + window.innerHeight,
        scrub: 1,
        invalidateOnRefresh: true
      }
    });
    entry
      .to(carousel, { autoAlpha: 1, scale: 1.2, duration: .75, ease: 'power2.out' }, .15)
      .to(root.querySelector('[data-nav]'), { autoAlpha: 1, duration: .25 }, .6);

    const stepBase = () => stepAnchor.getBoundingClientRect().top + window.scrollY;
    navigateToCard = (index) => {
      const target = Math.max(0, Math.min(labels.length - 1, index));
      const top = stepBase() + window.innerHeight * 2.8 * (target / (labels.length - 1));
      window.scrollTo({ top, behavior: 'smooth' });
    };

    let currentIndex = 0;
    const stepTo = (index) => {
      currentIndex = index;
      gsap.to(state, { rotation: -step * index, duration: .65, ease: 'power2.inOut', onUpdate: update });
    };

    ScrollTrigger.create({
      trigger: stepAnchor,
      start: 'top top',
      end: () => '+=' + window.innerHeight * 2.8,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const index = Math.round(self.progress * (labels.length - 1));
        if (index !== currentIndex) stepTo(index);
      }
    });
  }

  window.addEventListener('resize', update);

})();
(() => {
  const root = document.querySelector('#f6');

  const grid = root.querySelector('[data-grid]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 768px)').matches;
  const startWhite = .08;
  const endWhite = .8;
  const cells = [];
  const thresholds = [];
  let seed = 144;

  const random = () => {
    seed = (seed * 1664525 + 1013904223) >>> 0;
    return seed / 4294967296;
  };

  for (let i = 0; i < 144; i++) {
    thresholds.push({ i, t: random() });
  }
  thresholds.sort((a, b) => a.t - b.t).forEach((entry, order) => {
    entry.order = order / 143;
  });

  for (let i = 0; i < 144; i++) {
    const cell = document.createElement('span');
    cell.className = 'cell';
    cell.dataset.order = thresholds.find(item => item.i === i).order;
    grid.appendChild(cell);
    cells.push(cell);
  }

  const setWhite = (target) => {
    cells.forEach(cell => {
      cell.classList.toggle('is-white', Number(cell.dataset.order) < target);
    });
  };

  if (reduced || !desktop) {
    document.body.classList.add('reduced');
    setWhite(endWhite);
  } else {
    gsap.registerPlugin(ScrollTrigger);
    setWhite(startWhite);
    ScrollTrigger.create({
      trigger: grid,
      start: 'top 60%',
      end: 'top 0%',
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        setWhite(startWhite + self.progress * (endWhite - startWhite));
      }
    });
  }

})();
</script>

