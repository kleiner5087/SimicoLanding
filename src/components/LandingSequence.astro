  #f6{position:relative;z-index:1;--paper:#f8f9fa}
  .services-end{position:relative;min-height:100vh;overflow:hidden;background:var(--red)}
  .grid-wrap{position:absolute;z-index:2;left:0;right:0;bottom:0;height:25vw;background:var(--red);display:grid;grid-template-columns:repeat(24,1fr);grid-template-rows:repeat(6,1fr)}
  .grid-wrap :global(.cell){position:relative;display:block;background:var(--red);overflow:hidden}
  .grid-wrap :global(.cell)::before{content:"";position:absolute;inset:0;background:var(--paper);opacity:0;transform:scale(.72);transition:opacity .32s ease,transform .32s ease}
  .grid-wrap :global(.cell.is-white)::before{opacity:1;transform:scale(1)}
  .grid-wrap :global(.cell:nth-child(3n))::after{content:"";position:absolute;inset:0;box-shadow:inset 0 0 0 1px #ea322114;pointer-events:none}

  .f7-anchor{position:absolute;left:0;width:1px;height:1px;pointer-events:none}
  .f7-red-hold{position:relative;height:100vh;background:var(--red)}
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);
    const flow = document.querySelector('[data-flow]');
    const pipe = document.querySelector('[data-pipe]');
    const weld = document.querySelector('[data-weld]');
    const weldLabel = document.querySelector('[data-weld-label]');
    const statement = document.querySelector('[data-statement]');
    const about = document.querySelector('[data-about]');
    const photos = [...document.querySelectorAll('.continuum-about-photo')];
    const copy = document.querySelector('[data-copy]');
    const wordmark = document.querySelector('[data-wordmark]');
    const plate = document.querySelector('[data-plate]');
    const cta = document.querySelector('[data-cta]');
    const plant = document.querySelector('[data-plant]');
    const plantRed = document.querySelector('[data-plant-red]');
    const specAnchor = document.querySelector('[data-spec-anchor]');
    const contentAnchor = document.querySelector('[data-content-anchor]');
    const colorAnchor = document.querySelector('[data-color-anchor]');
    const specBlocks = [...document.querySelectorAll('[data-spec-block]')];
    const specBodiesRed = [...document.querySelectorAll('[data-spec-red]')];
    const specBodiesInk = [...document.querySelectorAll('[data-spec-ink]')];
    const flood = document.querySelector('[data-flood]');
    const finalMark = document.querySelector('[data-final]');
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const desktop = window.matchMedia('(min-width: 768px)').matches;

    if (reduced || !desktop) {
      document.body.classList.add('reduced');
      statement.style.opacity = '1';
      about.style.opacity = '1';
      plant.style.opacity = '1';
      finalMark.style.opacity = '1';
    } else {
      gsap.registerPlugin(ScrollTrigger);
      gsap.set(statement, { autoAlpha: 0, y: 22 });
      gsap.set(about, { autoAlpha: 0 });
      gsap.set([wordmark, copy, plate, cta], { autoAlpha: 0, y: 16 });
      gsap.set(photos, { autoAlpha: 0 });
      gsap.set(photos[0], { x: -36 });
      gsap.set(photos[1], { x: 36 });
      gsap.set(plant, { autoAlpha: 0 });
      gsap.set(finalMark, { autoAlpha: 0 });
      gsap.set(pipe, { scaleX: 1, rotation: 0, x: 0, y: 0 });
      gsap.set(specBlocks, { autoAlpha: 0, y: 18 });
      gsap.set(specBodiesRed, { autoAlpha: 1 });
      gsap.set(specBodiesInk, { autoAlpha: 0 });
      gsap.set(plantRed, { autoAlpha: 0 });
      gsap.set(flood, { yPercent: 100, autoAlpha: 1 });

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: flow,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 8.8,
          scrub: 1.15,
          invalidateOnRefresh: true
        }
      });

      window.__f3tl = tl;
      tl
        .to(statement, { autoAlpha: 1, y: 0, duration: .04 }, 0)
        .to(statement, { autoAlpha: 0, duration: .04 }, .09)
        .to(pipe, { scaleX: .589, duration: .16, ease: 'none' }, .10)
        .to(about, { autoAlpha: 1, duration: .05 }, .24)
        .to(wordmark, { autoAlpha: 1, y: 0, duration: .05 }, .24)
        .to(photos, { autoAlpha: 1, x: 0, duration: .07, stagger: .02, ease: 'power2.out' }, .25)
        .to([copy, plate, cta], { autoAlpha: 1, y: 0, duration: .06, stagger: .02, ease: 'power2.out' }, .27)
        .to({}, { duration: .19 })
        .to(photos, { autoAlpha: 0, x: (i) => i ? 36 : -36, duration: .05, ease: 'power1.in' }, .50)
        .to([wordmark, copy, plate, cta], { autoAlpha: 0, y: -28, duration: .05, ease: 'power1.in' }, .50)
        .to(pipe, { scaleX: .2945, duration: .06, ease: 'power1.inOut' }, .50)
        .to(about, { autoAlpha: 0, duration: .04 }, .54)
        .to(weld, { autoAlpha: 1, duration: .04 }, .56)
        .to(weldLabel, { autoAlpha: 1, duration: .04 }, .56)
        .to(pipe, { rotation: -45, duration: .10, ease: 'power1.inOut' }, .58)
        .to(pipe, {
          rotation: -90,
          scaleX: .0302,
          scaleY: .016296,
          x: '-5vw',
          y: () => window.innerHeight * .41575,
          duration: .15,
          ease: 'power1.inOut'
        }, .68)
        .to(plant, { autoAlpha: 1, duration: .03, ease: 'none' }, .76)
        .to(finalMark, { autoAlpha: 1, duration: .03 }, .80)
        .to(pipe, { autoAlpha: 0, duration: .03 }, .82)
        .to(weld, { autoAlpha: 0, duration: .03 }, .86)
        .to(weldLabel, { autoAlpha: 0, duration: .03 }, .86)
        .to({}, { duration: .14 });

      const contentTl = gsap.timeline({
        scrollTrigger: {
          trigger: contentAnchor,
          start: 'top top',
          end: () => '+=' + window.innerHeight * .112,
          scrub: 1,
          invalidateOnRefresh: true
        }
      });
      window.__f4content = contentTl;
      contentTl.to(specBlocks, { autoAlpha: 1, y: 0, duration: .08, stagger: .015, ease: 'power2.out' }, 0);

      const colorTl = gsap.timeline({
        scrollTrigger: {
          trigger: colorAnchor,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 1.008,
          scrub: 1.1,
          invalidateOnRefresh: true
        }
      });
      window.__f4color = colorTl;
      colorTl
        .to(plantRed, { autoAlpha: 1, duration: .14, ease: 'none' }, 0)
        .to(plant, { autoAlpha: 0, duration: .14, ease: 'none' }, 0)
        .to(specBodiesRed, { autoAlpha: 0, duration: .14, ease: 'none' }, 0)
        .to(specBodiesInk, { autoAlpha: 1, duration: .14, ease: 'none' }, 0);

      const specTl = gsap.timeline({
        scrollTrigger: {
          trigger: specAnchor,
          start: 'top top',
          end: () => '+=' + window.innerHeight * 2.4,
          scrub: 1.1,
          invalidateOnRefresh: true
        }
      });
      window.__f4spec = specTl;
      specTl
        .to(specBlocks, { autoAlpha: 0, y: -10, duration: .08, stagger: .01, ease: 'power1.in' }, .42)
        .to(flood, { yPercent: 0, duration: .36, ease: 'none' }, .60)
        .to(finalMark, { autoAlpha: 0, duration: .05 }, .93)
        .to({}, { duration: .02 });
    }

    // Debug de captura: ?static=1&p=0.32 (F3) · ?static=1&s=0.30 (F4)
    const params = new URLSearchParams(location.search);
    const debugP = Number(params.get('p'));
    const debugS = Number(params.get('s'));
    const staticPreview = params.get('static') === '1';
    const hasP = Number.isFinite(debugP) && debugP > 0;
    const hasS = params.has('s') && Number.isFinite(debugS);
    if (staticPreview) document.body.classList.add('static-preview');
    if (!reduced && desktop && (hasP || hasS) && window.__f3tl) {
      requestAnimationFrame(() => {
        if (staticPreview) {
          [window.__f3tl, window.__f4content, window.__f4color, window.__f4spec].forEach(tl => {
            if (!tl) return;
            tl.scrollTrigger?.kill();
            tl.scrollTrigger = null;
            tl.pause();
          });
        } else {
          const y = hasS ? specAnchor.getBoundingClientRect().top + window.scrollY : flow.offsetTop;
          window.scrollTo(0, y);
        }
        const overall = hasS
          ? Math.round((8.8 + Math.min(1, Math.max(0, debugS)) * 2.4) / 11.2 * 100)
          : Math.round(Math.min(1, Math.max(0, debugP)) * 8.8 / 11.2 * 100);
        if (hasS) window.__f3tl.progress(1).pause();
        else window.__f3tl.progress(Math.min(1, Math.max(0, debugP))).pause();
        if (window.__f4content) window.__f4content.progress(overall >= 70 ? 1 : 0).pause();
        if (window.__f4color) window.__f4color.progress(Math.min(1, Math.max(0, (overall - 76) / 9))).pause();
        if (window.__f4spec) window.__f4spec.progress(hasS ? Math.min(1, Math.max(0, debugS)) : 0).pause();
      });
    }

(() => {
  const root = document.querySelector('#f5');

  const flow = root.querySelector('[data-flow]');
  const carousel = root.querySelector('[data-carousel]');
  const stepAnchor = root.querySelector('[data-step-anchor]');
  const lines = root.querySelector('[data-lines]');
  const labels = [...root.querySelectorAll('[data-label]')];
  const prev = root.querySelector('[data-prev]');
  const next = root.querySelector('[data-next]');
  const progress = root.querySelector('[data-progress]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 768px)').matches;
  const step = 360 / labels.length;
  const state = { rotation: 0 };
  let activeIndex = 0;

  const update = () => {
    const measured = labels.map((el, index) => {
      const angle = 90 + index * step + state.rotation;
      const rad = angle * Math.PI / 180;
      const dist = Math.abs((((angle - 90) % 360) + 540) % 360 - 180);
      return { el, index, angle, rad, dist };
    });
    activeIndex = measured.reduce((best, item) => item.dist < best.dist ? item : best, measured[0]).index;
    measured.forEach(({ el, index, angle, dist }) => {
      const isActive = index === activeIndex;
      const isSide = dist < 90;
      const radius = isActive ? 18.3 : 22.4;
      const rad = angle * Math.PI / 180;
      const x = 50 + Math.cos(rad) * radius;
      let y = 0 + Math.sin(rad) * radius;
      if (isSide && !isActive) y -= 2.8;
      gsap.set(el, {
        left: x + 'vw',
        top: y + 'vw',
        xPercent: -50,
        yPercent: -50,
        opacity: isActive ? 1 : isSide ? .82 : 0,
        scale: isActive ? 1 : isSide ? .9 : .82,
        zIndex: isActive ? 20 : isSide ? 10 : 0
      });
      el.classList.toggle('is-active', isActive);
    });
    gsap.set(lines, { rotation: state.rotation });
    prev.disabled = activeIndex === 0;
    next.disabled = activeIndex === labels.length - 1;
  };

  let navigateToCard = (index) => {
    const target = Math.max(0, Math.min(labels.length - 1, index));
    gsap.to(state, { rotation: -step * target, duration: .65, ease: 'power2.inOut', onUpdate: update });
  };

  prev.addEventListener('click', () => navigateToCard(activeIndex - 1));
  next.addEventListener('click', () => navigateToCard(activeIndex + 1));

  if (reduced || !desktop) {
    document.body.classList.add('reduced');
    labels.forEach(el => el.classList.remove('is-active'));
  } else {
    gsap.registerPlugin(ScrollTrigger);
    gsap.set(carousel, { autoAlpha: 0, scale: .94 });
    gsap.set(root.querySelector('[data-nav]'), { autoAlpha: 0 });
    update();

    const entry = gsap.timeline({
      scrollTrigger: {
        trigger: flow,
        start: 'top top',
        end: () => '+=' + window.innerHeight,
        scrub: 1,
        invalidateOnRefresh: true
      }
    });
    entry
      .to(carousel, { autoAlpha: 1, scale: 1.2, duration: .75, ease: 'power2.out' }, .15)
      .to(root.querySelector('[data-nav]'), { autoAlpha: 1, duration: .25 }, .6);

    const stepBase = () => stepAnchor.getBoundingClientRect().top + window.scrollY;
    navigateToCard = (index) => {
      const target = Math.max(0, Math.min(labels.length - 1, index));
      const top = stepBase() + window.innerHeight * 2.8 * (target / (labels.length - 1));
      window.scrollTo({ top, behavior: 'smooth' });
    };

    let currentIndex = 0;
    const stepTo = (index) => {
      currentIndex = index;
      gsap.to(state, { rotation: -step * index, duration: .65, ease: 'power2.inOut', onUpdate: update });
    };

    ScrollTrigger.create({
      trigger: stepAnchor,
      start: 'top top',
      end: () => '+=' + window.innerHeight * 2.8,
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        const pct = Math.round(self.progress * 100);
        progress.style.width = pct + '%';
        const index = Math.round(self.progress * (labels.length - 1));
        if (index !== currentIndex) stepTo(index);
      }
    });
  }

  window.addEventListener('resize', update);

})();
(() => {
  const root = document.querySelector('#f6');

  const grid = root.querySelector('[data-grid]');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const desktop = window.matchMedia('(min-width: 768px)').matches;
  const startWhite = .08;
  const endWhite = .8;
  const cells = [];
  const thresholds = [];
  let seed = 144;

  const random = () => {
    seed = (seed * 1664525 + 1013904223) >>> 0;
    return seed / 4294967296;
  };

  for (let i = 0; i < 144; i++) {
    thresholds.push({ i, t: random() });
  }
  thresholds.sort((a, b) => a.t - b.t).forEach((entry, order) => {
    entry.order = order / 143;
  });

  for (let i = 0; i < 144; i++) {
    const cell = document.createElement('span');
    cell.className = 'cell';
    cell.dataset.order = thresholds.find(item => item.i === i).order;
    grid.appendChild(cell);
    cells.push(cell);
  }

  const setWhite = (target) => {
    cells.forEach(cell => {
      cell.classList.toggle('is-white', Number(cell.dataset.order) < target);
    });
  };

  if (reduced || !desktop) {
    document.body.classList.add('reduced');
    setWhite(endWhite);
  } else {
    gsap.registerPlugin(ScrollTrigger);
    setWhite(startWhite);
    ScrollTrigger.create({
      trigger: grid,
      start: 'top 60%',
      end: 'top 0%',
      invalidateOnRefresh: true,
      onUpdate: (self) => {
        setWhite(startWhite + self.progress * (endWhite - startWhite));
      }
    });
  }

})();
</script>
