  :global(.reduced) .disc,:global(.reduced) .sector-lines{display:none}
  :global(.reduced) .title-pill{position:relative;left:auto;top:auto;width:auto;height:auto;transform:none;background:transparent;border-radius:0;margin:0 0 6vh;pointer-events:auto}
  :global(.reduced) .title-pill h1{position:relative;left:auto;top:auto;width:auto;transform:none;color:var(--paper);font-size:clamp(2.4rem,7vw,4.2rem)}
  :global(.reduced) .labels{position:relative;inset:auto;display:grid;grid-template-columns:repeat(2,1fr);gap:24px 28px;pointer-events:auto}
  :global(.reduced) .svc{position:relative!important;left:auto!important;top:auto!important;width:auto;opacity:1!important;transform:none!important}
