  .final-mark .zero::before{content:"";position:absolute;right:100%;top:.55em;width:38px;height:1px;background:#c9b900;margin-right:8px}

  /* F4 · About + Specialties */
  .content-anchor{position:absolute;top:772.8vh;left:0;width:1px;height:1px;pointer-events:none}
  .color-anchor{position:absolute;top:851.2vh;left:0;width:1px;height:1px;pointer-events:none}
  .spec-anchor{position:absolute;top:880vh;left:0;width:1px;height:1px;pointer-events:none}
  .spec-block{position:absolute;z-index:6;width:23vw;padding:12px 14px;background:linear-gradient(180deg,rgba(255,254,245,.95),rgba(255,254,245,.8));color:var(--ink);font:400 clamp(.7rem,.82vw,.92rem)/1.4 var(--mono);opacity:0;will-change:transform,opacity;pointer-events:none}
  .spec-block .num{display:block;font:700 10px/1 var(--mono);letter-spacing:.08em;color:var(--red);margin-bottom:8px}
  .spec-block h4{margin:0 0 6px;font:800 clamp(1.25rem,1.9vw,2rem)/.95 var(--sans);letter-spacing:-.02em}
  .spec-copy{display:grid}
  .spec-copy p{grid-area:1/1;margin:0}
  .spec-copy .body-ink{opacity:0}
  .spec-block .leader{position:absolute;left:14px;top:100%;width:1px;height:9vh;background:#23252955}
  .spec-block .leader::after{content:"";position:absolute;left:0;top:100%;width:4vw;height:1px;background:#23252955}
  .flood{position:absolute;z-index:3;left:0;right:0;bottom:0;height:100%;background:var(--red);will-change:transform;pointer-events:none}
  .flood .line{position:absolute;left:0;right:0;top:0;height:1px;background:#fff3}

  /* Modo captura estática: ?static=1&p=0.32 */
  :global(.static-preview) .flow{height:100vh}
  :global(.static-preview) .stage{position:relative}

  /* Reduced motion y móvil: secuencia estática, sin pin */
  :global(.reduced) .flow{height:auto}
