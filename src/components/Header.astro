---
// EDITABLE: Header Logo String/Image
const logo = '/simico_largo.svg';
// EDITABLE: Header Navigation Links Array
const links = [
  { label: 'Inicio', href: '/' },
  { label: 'Quiénes somos', href: '/#about' },
  { label: 'Servicios', href: '/#servicios' },
  { label: 'Proyectos', href: '/proyectos' },
];
// EDITABLE: Header CTA Label & URL
const cta = { label: 'Contacto', href: '/#contacto' };
---

<header class="site-header" data-header>
  <div class="header-inner">
    <a class="brand" href="/" aria-label="SIMICO, volver al inicio"><img src={logo} alt="SIMICO" /></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="primary-navigation" data-menu-toggle>
      <span></span><span></span><span></span><span class="sr-only">Abrir menú</span>
    </button>
    <nav id="primary-navigation" class="primary-nav" aria-label="Navegación principal" data-navigation>
      <div class="nav-links">
        {links.map((link) => <a href={link.href}>{link.label}</a>)}
      </div>
      <a class="header-cta" href={cta.href}>{cta.label}</a>
    </nav>
  </div>
</header>

<script>
  const header = document.querySelector('[data-header]');
  const hero = document.querySelector('#inicio');
  const narratives = [...document.querySelectorAll('[data-narrative]')];
  const projects = document.querySelector('[data-projects-timeline]');
  const toggle = document.querySelector('[data-menu-toggle]');
  const nav = document.querySelector('[data-navigation]');
  const path = window.location.pathname.toLowerCase();
  const isProjectsPage = path.startsWith('/proyectos');
  let lastScrollY = window.scrollY;
  let heroHeight = 0;
  const narrativeBounds = { top: 0, bottom: 0 };
  const projectsBounds = { top: 0, bottom: 0 };
  const measureSections = () => {
    heroHeight = hero?.offsetHeight ?? 0;
    const narrative = narratives.find((element) => element.getClientRects().length > 0);
    if (narrative) {
      const rect = narrative.getBoundingClientRect();
      narrativeBounds.top = rect.top + window.scrollY;
      narrativeBounds.bottom = rect.bottom + window.scrollY;
    } else {
      narrativeBounds.top = Number.POSITIVE_INFINITY;
      narrativeBounds.bottom = Number.NEGATIVE_INFINITY;
    }
    if (projects) {
      const rect = projects.getBoundingClientRect();
      projectsBounds.top = rect.top + window.scrollY;
      projectsBounds.bottom = rect.bottom + window.scrollY;
    } else {
      projectsBounds.top = Number.POSITIVE_INFINITY;
      projectsBounds.bottom = Number.NEGATIVE_INFINITY;
    }
  };
  const updateScroll = (force = false) => {
    const currentScrollY = window.scrollY;
    const delta = currentScrollY - lastScrollY;
    if (!force && delta === 0) return;
    const scrollingUp = delta < 0;

    if (isProjectsPage) {
      if (currentScrollY <= 12) {
        header?.classList.remove('hide-header', 'scrolled');
      } else {
        header?.classList.toggle('hide-header', !scrollingUp);
        header?.classList.toggle('scrolled', scrollingUp);
      }
      lastScrollY = currentScrollY;
      return;
    }

    const inHero = Boolean(hero && currentScrollY < heroHeight - 2);
    const inNarrative = currentScrollY > narrativeBounds.top - window.innerHeight && currentScrollY < narrativeBounds.bottom;
    const inProjects = currentScrollY > projectsBounds.top - window.innerHeight && currentScrollY < projectsBounds.bottom;

    if (inHero) {
      header?.classList.remove('scrolled');
      header?.classList.toggle('hide-header', currentScrollY > 12 && !scrollingUp);
    } else if (inNarrative) {
      header?.classList.add('hide-header');
      header?.classList.remove('scrolled');
    } else if (inProjects) {
      header?.classList.toggle('hide-header', !scrollingUp);
      header?.classList.toggle('scrolled', scrollingUp);
    } else {
      header?.classList.toggle('hide-header', currentScrollY > 12 && !scrollingUp);
      header?.classList.toggle('scrolled', currentScrollY > 12 && scrollingUp);
    }
    lastScrollY = currentScrollY;
  };
  measureSections();
  window.addEventListener('scroll', () => updateScroll(), { passive: true });
  window.addEventListener('resize', () => {
    requestAnimationFrame(() => {
      measureSections();
      updateScroll(true);
    });
  }, { passive: true });
  updateScroll(true);
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
    document.body.classList.toggle('menu-open', open);
  });
  nav?.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => {
    nav.classList.remove('open');
    toggle?.setAttribute('aria-expanded', 'false');
    document.body.classList.remove('menu-open');
  }));
</script>
