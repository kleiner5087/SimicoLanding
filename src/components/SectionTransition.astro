<div class="section-transition" data-section-transition>
  <svg viewBox="0 0 1000 440" preserveAspectRatio="none" aria-hidden="true" focusable="false">
    <path data-transition-path d="M 170 0 C 170 76 188 110 238 136 C 294 165 350 172 382 216 C 408 251 398 322 398 440" />
    <path data-transition-path d="M 830 0 C 830 76 812 110 762 136 C 706 165 650 172 618 216 C 592 251 602 322 602 440" />
  </svg>
</div>
<script>
  const transition = document.querySelector('[data-section-transition]');
  const paths = [...document.querySelectorAll('[data-transition-path]')];
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (transition && paths.length) {
    const lengths = paths.map((path) => path.getTotalLength());
    paths.forEach((path, index) => { path.style.strokeDasharray = `${lengths[index]}`; path.style.strokeDashoffset = `${lengths[index]}`; });
    let target = 0; let current = 0; let frame = 0;
    const animate = () => {
      current += (target - current) * 0.14;
      paths.forEach((path, index) => { path.style.strokeDashoffset = `${lengths[index] * (1 - current)}`; });
      frame = Math.abs(target - current) > 0.001 ? requestAnimationFrame(animate) : 0;
    };
    const updateTarget = () => {
      const rect = transition.getBoundingClientRect();
      target = reduced ? 1 : Math.min(1, Math.max(0, (innerHeight - rect.top) / (innerHeight + rect.height)));
      if (!frame) frame = requestAnimationFrame(animate);
    };
    addEventListener('scroll', updateTarget, { passive: true }); addEventListener('resize', updateTarget); updateTarget();
  }
</script>
